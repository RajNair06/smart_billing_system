@model SmartBillingSystem.Models.ViewModels.BillResultViewModel
@{
    Layout = null;
    ViewData["Title"] = "Print — Bill " + Model.Bill.BillId;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Bill #@Model.Bill.BillId</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&family=JetBrains+Mono:wght@100..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/print.css" media="print" />
    <style>
        body {
            font-family: 'Source Serif 4', Georgia, serif;
            background: #fff;
            color: #000;
            padding: 2rem;
            max-width: 800px;
            margin: 0 auto;
        }
        .print-header {
            border-bottom: 4px solid #000;
            padding-bottom: 1rem;
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
        }
        .print-header h1 {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 1.5rem;
            letter-spacing: -0.02em;
        }
        .print-header .meta {
            text-align: right;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            color: #525252;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        .print-header .meta strong {
            display: block;
            font-size: 0.875rem;
            color: #000;
            letter-spacing: 0.05em;
        }
        .print-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
        }
        .print-table th {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #525252;
            text-align: left;
            padding: 0.75rem 1rem;
            border-bottom: 2px solid #000;
        }
        .print-table td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #E5E5E5;
            font-size: 0.9rem;
        }
        .print-table .text-right { text-align: right; }
        .print-totals {
            margin-left: auto;
            min-width: 300px;
            border-top: 2px solid #000;
            padding-top: 1rem;
        }
        .print-totals .row {
            display: flex;
            justify-content: space-between;
            padding: 0.25rem 0;
            font-size: 0.9rem;
        }
        .print-totals .row .label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #525252;
        }
        .print-totals .row--grand {
            border-top: 2px solid #000;
            margin-top: 0.5rem;
            padding-top: 0.75rem;
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 1.25rem;
            font-weight: 700;
        }
        .print-recommendations {
            margin-top: 2rem;
            padding-top: 1rem;
            border-top: 1px solid #E5E5E5;
        }
        .print-recommendations h3 {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #525252;
            margin-bottom: 0.5rem;
        }
        .print-recommendations li {
            font-size: 0.9rem;
            padding: 0.15rem 0;
            list-style: none;
        }
        .print-recommendations li::before {
            content: "— ";
            color: #525252;
        }
        .print-actions {
            margin-top: 2rem;
            display: flex;
            gap: 1rem;
        }
    </style>
</head>
<body>
    <div>
        <div class="print-header">
            <div>
                <h1>Smart Billing</h1>
                <p style="font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; color: #525252; text-transform: uppercase; letter-spacing: 0.12em;">Tax Invoice</p>
            </div>
            <div class="meta">
                <strong>Bill #@Model.Bill.BillId</strong>
                <span>@Model.Bill.DateCreated.ToString("dd MMM yyyy")</span>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Bill.CustomerName))
        {
            <div style="margin-bottom: 1.5rem; padding: 1rem; border: 1px solid #E5E5E5;">
                <p style="font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.12em; color: #525252; margin-bottom: 0.5rem;">Bill To</p>
                <p style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.1rem; font-weight: 700; margin: 0;">
                    @Model.Bill.CustomerName
                </p>
                @if (!string.IsNullOrWhiteSpace(Model.Bill.CustomerContact))
                {
                    <p style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: #525252; margin: 0.25rem 0 0 0;">
                        @Model.Bill.CustomerContact
                    </p>
                }
            </div>
        }

        <table class="print-table">
            <thead>
                <tr>
                    <th style="width:5%;">#</th>
                    <th style="width:40%;">Product</th>
                    <th class="text-right" style="width:18%;">Price</th>
                    <th class="text-right" style="width:10%;">Qty</th>
                    <th class="text-right" style="width:18%;">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Bill.Items)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.ProductName</td>
                        <td class="text-right">₹@item.UnitPrice.ToString("N2")</td>
                        <td class="text-right">@item.Quantity</td>
                        <td class="text-right">₹@item.LineTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="print-totals">
            <div class="row">
                <span class="label">Subtotal</span>
                <span>₹@Model.Bill.Subtotal.ToString("N2")</span>
            </div>
            <div class="row">
                <span class="label">GST (@Model.Bill.TaxRate.ToString("P0"))</span>
                <span>₹@Model.Bill.TaxAmount.ToString("N2")</span>
            </div>
            <div class="row row--grand">
                <span>Total</span>
                <span>₹@Model.Bill.GrandTotal.ToString("N2")</span>
            </div>
        </div>

        @if (Model.Bill.Recommendations.Any())
        {
            <div class="print-recommendations">
                <h3>AI Recommendations</h3>
                <ul>
                    @foreach (var rec in Model.Bill.Recommendations)
                    {
                        <li>@rec</li>
                    }
                </ul>
            </div>
        }

        <div class="print-actions no-print">
            <button type="button" class="btn btn--primary" onclick="window.print()">Print</button>
            <a href="@Url.Action("Result", "Bill")" class="btn btn--ghost">← Back</a>
        </div>
    </div>
</body>
</html>
