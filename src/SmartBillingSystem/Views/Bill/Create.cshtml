@model SmartBillingSystem.Models.ViewModels.CreateBillViewModel
@{
    ViewData["Title"] = "Create Bill";
}

<section class="section" style="padding-top: var(--space-24); padding-bottom: var(--space-24);">
    <div class="container">
        <p class="text-label" data-animate="fade-in" style="margin-bottom: var(--space-6);">New Invoice</p>
        <h1 data-animate="fade-up" style="margin-bottom: var(--space-12); font-size: var(--text-display);">
            Create <em class="text-italic">your bill.</em>
        </h1>

        <hr class="section-rule section-rule--thin" style="margin-bottom: var(--space-12);" />

        <form id="billing-form" asp-action="Create" asp-controller="Bill" method="post" data-animate="fade-up" data-animate-delay="1">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div style="border: 2px solid #000; padding: var(--space-4); margin-bottom: var(--space-8); background: var(--color-muted);">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p style="font-family: var(--font-mono); font-size: var(--text-micro); text-transform: uppercase; letter-spacing: var(--tracking-widest); margin: 0;">@error.ErrorMessage</p>
                    }
                </div>
            }

            <div id="empty-state" class="empty-state">
                <div class="empty-state__icon">+</div>
                <h3>Add Products to Your Invoice</h3>
                <p>Enter product names, prices, and quantities below. Use AI suggestions to discover related products.</p>
                <div class="empty-state__steps">
                    <div class="step">
                        <span class="step__number">1</span>
                        <span class="step__text">Add products with prices and quantities</span>
                    </div>
                    <div class="step">
                        <span class="step__number">2</span>
                        <span class="step__text">Get AI suggestions for related products</span>
                    </div>
                    <div class="step">
                        <span class="step__number">3</span>
                        <span class="step__text">Generate your professional bill</span>
                    </div>
                </div>
            </div>

            <div id="table-wrapper">
                <table class="product-table">
                    <thead>
                        <tr>
                            <th style="width: 40%;">Product</th>
                            <th style="width: 20%;" class="text-right">Price (₹)</th>
                            <th style="width: 12%;" class="text-right">Qty</th>
                            <th style="width: 18%;" class="text-right">Total</th>
                            <th style="width: 10%;"></th>
                        </tr>
                    </thead>
                    <tbody id="product-rows">
                    </tbody>
                </table>

                <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-8);">
                    <button type="button" class="btn btn--ghost" id="add-row-btn">+ Add Row</button>
                    <button type="button" class="btn btn--secondary" id="suggest-btn">Suggest Products</button>
                </div>

                <div id="recommendations-section" style="display: none; margin-bottom: var(--space-8); border-top: 2px solid var(--color-border); padding-top: var(--space-8);">
                    <p class="text-label" style="margin-bottom: var(--space-4);">AI Recommendations</p>
                    <div id="recommendations-list" style="display: flex; gap: var(--space-4); flex-wrap: wrap;">
                    </div>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end;" data-animate="fade-up" data-animate-delay="2">
                <div class="bill-summary" style="min-width: 300px; max-width: 420px; width: 100%;">
                    <div class="total-row">
                        <span class="text-label">Subtotal</span>
                        <span class="text-numeric" id="subtotal-display">₹0.00</span>
                    </div>
                    <div class="total-row">
                        <span class="text-label">GST (18%)</span>
                        <span class="text-numeric" id="tax-display">₹0.00</span>
                    </div>
                    <div class="total-row total-row--grand">
                        <span>Total</span>
                        <span class="text-numeric" id="grand-total-display">₹0.00</span>
                    </div>
                </div>
            </div>

            <hr class="section-rule section-rule--thin" style="margin-top: var(--space-12); margin-bottom: var(--space-8);" />

            <div style="display: flex; gap: var(--space-4); flex-wrap: wrap;">
                <button type="submit" class="btn btn--primary">Generate Bill →</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn--secondary">Cancel</a>
            </div>
        </form>
    </div>
</section>
