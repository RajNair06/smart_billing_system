<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Smart Billing</title>

    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&family=JetBrains+Mono:wght@100..800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" media="print" asp-append-version="true" />
</head>
<body class="texture-noise">
    <nav class="nav no-print">
        <a href="/" class="nav__brand">Smart Billing</a>
        <ul class="nav__links">
            @{
                var controller = ViewContext.RouteData.Values["controller"]?.ToString();
            }
            @if (controller == "Home")
            {
                <li><a asp-controller="Bill" asp-action="Create">Create Bill →</a></li>
            }
            else
            {
                <li><a asp-controller="Home" asp-action="Index">← Home</a></li>
            }
        </ul>
    </nav>

    <main>
        @RenderBody()
    </main>

    <script src="~/js/site.js" defer asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
